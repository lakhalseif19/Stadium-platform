# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=stadium_app
DB_PASSWORD=replace_with_a_unique_database_password
DB_NAME=stadium_platform
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis / Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Browser origins; production requires explicitly configured HTTPS origins.
CORS_ORIGINS=http://localhost:3001

# Authentication
JWT_ACCESS_SECRET=replace_with_a_unique_random_access_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_refresh_secret_of_at_least_32_characters
JWT_QR_SECRET=replace_with_a_different_random_qr_secret_of_at_least_32_characters
# Legacy key is retained only to verify existing sessions during key migration.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment, SMS, and email are not integrated. These services remain unavailable;
# adding credentials alone does not activate a provider or OTP delivery.
